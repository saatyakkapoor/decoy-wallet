<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_money_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/brand_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search" />

        <ImageView
            android:id="@+id/btnNotify"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_bell"
            android:contentDescription="Notifications" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Greeting hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/greetingHi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hi SANJAY, Delighted to see you."
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/greetingSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Experience the Simplified Banking."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Big cash bait — designed to be tapped first -->
            <LinearLayout
                android:id="@+id/cashBait"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_cash_bait"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_money_logo"
                    android:contentDescription="Cash reward" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#33FFFFFF"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="⚡ LIMITED TIME"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="₹25,000 Cash Reward"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap to claim into your account now"
                        android:textColor="#EEFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClaimBait"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_claim_btn"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="CLAIM"
                    android:textColor="#0B8F4E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="4dp">

                <LinearLayout
                    android:id="@+id/tabExplore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="28dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tabExploreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explore"
                        android:textColor="@color/brand_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/tabExploreLine"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tab_underline" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabQuick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tabQuickText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Access"
                        android:textColor="@color/text_muted"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/tabQuickLine"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_tab_underline"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_stroke" />

            <!-- Explore grid -->
            <GridLayout
                android:id="@+id/exploreGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="4"
                android:paddingHorizontal="12dp"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:useDefaultMargins="true" />

            <!-- Quick access panel (hidden by default) -->
            <LinearLayout
                android:id="@+id/quickPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_balance_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_balance"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/balanceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="₹1,24,805.56"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/upiIdText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="aarav@aubank"
                        android:textColor="#E6FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout android:id="@+id/actionAdd" style="@style/ActionItem">
                        <ImageView style="@style/ActionIcon" android:src="@drawable/ic_add" android:tint="@color/brand_primary" />
                        <TextView style="@style/ActionText" android:text="@string/add_money" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/actionSend" style="@style/ActionItem">
                        <ImageView style="@style/ActionIcon" android:src="@drawable/ic_send" android:tint="@color/brand_primary" />
                        <TextView style="@style/ActionText" android:text="@string/send" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/actionScan" style="@style/ActionItem">
                        <ImageView style="@style/ActionIcon" android:src="@drawable/ic_scan" android:tint="@color/brand_primary" />
                        <TextView style="@style/ActionText" android:text="@string/scan" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/actionBills" style="@style/ActionItem">
                        <ImageView style="@style/ActionIcon" android:src="@drawable/ic_bills" android:tint="@color/brand_primary" />
                        <TextView style="@style/ActionText" android:text="@string/bills" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/recent_activity" />

                <LinearLayout
                    android:id="@+id/txContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- FD banner -->
            <LinearLayout
                android:id="@+id/fdBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_banner"
                android:gravity="center_vertical"
                android:minHeight="120dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/fdRateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="7.19%* Annualised Interest on Fixed Deposit"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/btnApplyFd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_cta_purple"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="Apply Now"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_weight="0.8"
                    android:contentDescription="Offer"
                    android:padding="8dp"
                    android:src="@drawable/ic_au_mark" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
